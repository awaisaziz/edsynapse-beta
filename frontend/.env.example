# ── EdSynapse environment ─────────────────────────────────────────────────────
# Don't fill this in by hand. The real values live in the Vercel project; pull
# them locally with:  vercel env pull frontend/.env.local --environment=development
# (The OIDC token below expires ~12h — re-run that command when local DB calls
# start failing with auth errors.)

# Amazon Aurora PostgreSQL — reached via IAM auth, NOT a connection string.
# lib/db.ts assumes AWS_ROLE_ARN using VERCEL_OIDC_TOKEN, then mints a short-lived
# RDS auth token as the pg password. There is no DATABASE_URL and no DB password.
AWS_REGION="us-east-1"
PGHOST=""              # Aurora cluster endpoint
PGUSER="postgres"
PGDATABASE="postgres"
AWS_ROLE_ARN=""        # IAM role the Vercel OIDC token is allowed to assume
VERCEL_OIDC_TOKEN=""   # auto-provided on Vercel; pulled locally via `vercel env pull`

# OpenAI — quiz/assessment generation, streaming tutor, grading, embeddings.
OPENAI_API_KEY=""
# Default chat model (CHAT_MODEL in src/lib/openai.ts). Optional — defaults to gpt-4o-mini.
OPENAI_MODEL="gpt-4o-mini"

# Email (Resend) — transactional email for email verification + password reset.
# Resend is an HTTPS API (no SMTP server). When RESEND_API_KEY is unset, auth
# still works but verification/reset emails are skipped (logged server-side).
RESEND_API_KEY=""
# Sender. Until you verify a domain in Resend, their shared sender works for
# testing (delivers only to your own Resend account email):
EMAIL_FROM="EdSynapse <onboarding@resend.dev>"
# Public base URL used to build links in emails (e.g. https://edsynapse-beta.vercel.app).
# Falls back to the request origin when unset.
NEXT_PUBLIC_APP_URL=""

# TEMPORARY dev-only auth bypass. When "true", no sign-in is required: requests
# resolve to the most-recent active user of the role pinned by visiting any
# protected page with `?as=teacher` or `?as=student` (defaults to teacher).
# Use ONLY in local development while real auth is being built. Never set in
# Production. See src/lib/auth.ts + src/middleware.ts.
NEXT_PUBLIC_DEV_AUTH_BYPASS="false"

# Optional: point the typed client (src/lib/edsynapseApi.ts) at an external API.
# Leave empty to use same-origin Next.js /api routes.
NEXT_PUBLIC_API_URL=""

# Optional: public-beta feedback Google Form. Shown as "Feedback" / "Share
# Feedback" links in the landing nav and the student/teacher app shell. Empty =
# links render as a "#" placeholder (see src/lib/feedback.ts).
NEXT_PUBLIC_FEEDBACK_URL=""
